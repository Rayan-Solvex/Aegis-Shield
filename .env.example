# Aegis Shield environment template
# Copy to .env for local development or use directly in Codespaces secrets.

# Frontend / API
VITE_API_BASE_URL=

# Solana RPC selection
VITE_SOLANA_RPC_DEVNET=https://api.devnet.solana.com
VITE_SOLANA_RPC_MAINNET=https://api.mainnet-beta.solana.com
VITE_SOLANA_WS_DEVNET=wss://api.devnet.solana.com
VITE_SOLANA_WS_MAINNET=wss://api.mainnet-beta.solana.com
VITE_SOLANA_NETWORK=devnet
VITE_SOLANA_COMMITMENT=confirmed

# Future routing / transaction preferences
VITE_TX_ROUTING_MODE=rpc
VITE_TX_SUBMISSION_STRATEGY=rpc
VITE_ENABLE_QUIC_ROUTING=false
VITE_ENABLE_LEADER_TPU=false
VITE_PREFERRED_RPC_PROVIDER=solana-public

# Premium provider endpoints
VITE_HELIUS_DEVNET_RPC=
VITE_HELIUS_MAINNET_RPC=
VITE_QUICKNODE_DEVNET_RPC=
VITE_QUICKNODE_MAINNET_RPC=
VITE_BLOCKSPRINT_DEVNET_RPC=
VITE_BLOCKSPRINT_MAINNET_RPC=

# Anchor migration / protocol bootstrap
AEGIS_MIN_AUDITOR_STAKE_SOL=1
AEGIS_SLASH_DESTINATION=
AEGIS_PROTOCOL_ADMIN=